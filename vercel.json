{
  "redirects": [
    {
      "source": "/start",
      "destination": "https://wizard.tigerclaw.io/",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "https://wizard.tigerclaw.io/dashboard",
      "permanent": false
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://wizard.tigerclaw.io/dashboard",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "https://wizard.tigerclaw.io/dashboard",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/agent-facts",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
