{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.tigerclaw.io" }],
      "destination": "https://tigerclaw.io/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tiger-claw-marketing-restore.vercel.app" }],
      "destination": "https://tigerclaw.io/:path*",
      "permanent": true
    },
    {
      "source": "/start",
      "destination": "https://wizard.tigerclaw.io/",
      "permanent": false
    },
    {
      "source": "/dashboard",
      "destination": "https://wizard.tigerclaw.io/dashboard",
      "permanent": false
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://wizard.tigerclaw.io/dashboard",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "https://wizard.tigerclaw.io/dashboard",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/agent-facts",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/legal", "destination": "/index.html" },
    { "source": "/legal/:slug", "destination": "/index.html" },
    { "source": "/brand", "destination": "/index.html" },
    { "source": "/sms", "destination": "/index.html" }
  ]
}
